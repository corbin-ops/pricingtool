# ─── Follow Up Boss integration ───────────────────────────────────────────
# Copy to .env for local dev, or set these in Render → Environment.
# NEVER commit real values. .env is gitignored.

# FUB API key — Admin → API → generate. Used for server-to-server calls.
FUB_API_KEY=

# Embedded-app secret key — from registering the embedded app in FUB.
# Used to verify the ?signature on each embedded load (HMAC-SHA256).
FUB_EMBED_SECRET=

# ─── Person field mapping (used by /api/fub/parcel) ────────────────────────
# Override to match YOUR FUB field names. Defaults shown.
# Discover real keys with:  GET /api/fub/personfields?personId=<id>
# (a field named "Assessed Value" becomes customAssessedValue, etc.)
FUB_FIELD_MARKET_VALUE=price
FUB_FIELD_ASSESSED=customAssessedLandValue
FUB_FIELD_MARKET_LAND=customMarketLandValue
FUB_FIELD_APN=customAPN
FUB_FIELD_MAIL_STATE=customMailState
FUB_FIELD_MAIL_COUNTY=customMailCounty
FUB_FIELD_LI_LINK=customParcelLink
FUB_FIELD_SELLER_ASKING=customSellerAskingPrice

# Legacy: Deal value field used by the older /api/fub/deal endpoint
FUB_DEAL_VALUE_FIELD=price

# Port (Render sets this automatically; default 8080 locally)
# PORT=8080
